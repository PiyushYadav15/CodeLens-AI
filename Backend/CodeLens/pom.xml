<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
           https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    PARENT: Inherits pre-configured versions for hundreds of libraries from
    Spring Boot's master build file. You rarely need to specify versions below.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.codelens</groupId>
  <artifactId>CodeLens</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>CodeLens AI</name>
  <description>AI-powered code repository Q&amp;A with source citations</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>

    <!-- ═══════════════════════════════════════════════════
         WEB LAYER
         ═══════════════════════════════════════════════════ -->

    <!--
      SPRING WEB: Lets you write REST controllers with @RestController.
      Bundles Tomcat as an embedded server — run your app with just `java -jar`.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      SPRING WEBFLUX: Used only for its WebClient — a modern, non-blocking
      HTTP client. We use this to call external AI APIs (OpenAI / Gemini)
      without blocking a server thread while waiting for the response.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>

    <!-- ═══════════════════════════════════════════════════
         DATABASE LAYER
         ═══════════════════════════════════════════════════ -->

    <!--
      SPRING DATA JPA: Lets you talk to a database using Java classes
      (@Entity) instead of raw SQL. Spring auto-creates tables for you.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>


    <!--
      POSTGRESQL JDBC DRIVER: Allows Spring Boot to connect to a PostgreSQL
      database (with pgvector support).
      scope=runtime: only needed when the application runs.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ═══════════════════════════════════════════════════
         CODE QUALITY
         ═══════════════════════════════════════════════════ -->

    <!--
      LOMBOK: Generates boilerplate at compile time.
      @Data = getters + setters + toString + equals + hashCode
      @Builder = fluent builder pattern
      @Slf4j = gives you a `log` field for logging
      optional=true: not pulled in by projects that depend on yours.
    -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ═══════════════════════════════════════════════════
         JSON (JACKSON)
         ═══════════════════════════════════════════════════ -->

    <!--
      JACKSON DATABIND: The library that converts Java objects ↔ JSON.
      Spring Boot's @RestController uses this automatically to serialize
      your return values into JSON responses.

      It also provides ObjectMapper — the class we use in
      GeminiEmbeddingClient to build/parse JSON programmatically.

      Why explicit? spring-boot-starter-web pulls this in transitively,
      but Spring Boot 4.0.8 (milestone build) doesn't always make it
      available on the compile classpath without an explicit declaration.
      No <version> needed — the Spring Boot BOM manages the version.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- ═══════════════════════════════════════════════════
         VALIDATION
         ═══════════════════════════════════════════════════ -->

    <!--
      SPRING VALIDATION: Annotate your request DTOs with rules:
      @NotBlank, @NotNull, @Size(max=500), etc.
      Spring checks them automatically on every incoming request.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ═══════════════════════════════════════════════════
         TESTING
         ═══════════════════════════════════════════════════ -->

    <!--
      SPRING BOOT TEST: Everything for writing tests.
      Includes JUnit 5 (test runner), Mockito (faking dependencies),
      and AssertJ (readable assertions).
      scope=test: never included in the final production JAR.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <!--
        MAVEN COMPILER PLUGIN: Controls how javac compiles your source code.
        We explicitly register Lombok here as an "annotation processor".

        WHY IS THIS NEEDED?
        Lombok works by reading your source code during compilation and
        generating extra code (@Getter → getters, @Slf4j → log field, etc.).
        To do this it needs to be registered as an "annotation processor" —
        a plugin that javac runs before finishing compilation.

        Without this block, newer versions of Maven / Spring Boot 4.x may
        not discover Lombok automatically, causing errors like:
          "cannot find symbol: variable log"   (from @Slf4j)
          "cannot find symbol: method builder()" (from @Builder)

        annotationProcessorPaths: an explicit list of processors to run.
        By listing Lombok here, we guarantee javac finds and runs it,
        regardless of how Maven resolves the classpath.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <!-- No version needed — inherited from spring-boot-starter-parent -->
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
        SPRING BOOT MAVEN PLUGIN: Packages everything into a single runnable
        "fat JAR". Excludes Lombok since it's only needed at compile time
        and must not ship in the final artifact.
      -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

    </plugins>
  </build>

</project>
